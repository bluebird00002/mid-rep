# ========================
# MiD Diary System - Environment Configuration
# ========================

# ========================
# Database Configuration
# ========================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mid_diary

# ========================
# Server Configuration
# ========================
PORT=3000
NODE_ENV=development

# ========================
# JWT Authentication
# ========================
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRES_IN=1d

# Username of the initial trusted owner. That existing account is promoted to
# superadmin on its next successful normal login. Never use an untrusted name.
MID_BOOTSTRAP_ADMIN_USERNAME=

# ========================
# Firebase Configuration (Optional)
# ========================
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ========================
# Cloudinary Configuration (For Image Storage)
# ========================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ========================
# Mother AI / Groq Configuration
# ========================
# Create the gsk_ key at https://console.groq.com/keys and keep it server-side only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ========================
# CORS Configuration
# ========================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001,http://localhost:5174

# ========================
# Environment-Specific Settings
# ========================
# For development: use local services and a Groq API key
# For production: use production database and ensure GROQ_API_KEY is set

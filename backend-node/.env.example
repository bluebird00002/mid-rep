# ========================
# MiD Diary System - Environment Configuration
# ========================

# ========================
# Database Configuration
# ========================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mid_diary

# ========================
# Server Configuration
# ========================
PORT=3000
NODE_ENV=development

# ========================
# JWT Authentication
# ========================
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRES_IN=1d

# Username of the initial trusted owner. That existing account is promoted to
# superadmin on its next successful normal login. Never use an untrusted name.
MID_BOOTSTRAP_ADMIN_USERNAME=

# ========================
# Firebase Configuration (Optional)
# ========================
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ========================
# Cloudinary Configuration (For Image Storage)
# ========================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ========================
# Mother AI / xAI Grok Configuration
# ========================
# Create the key at https://console.x.ai/ and keep it server-side only.
XAI_API_KEY=
XAI_MODEL=grok-4.5

# ========================
# CORS Configuration
# ========================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001,http://localhost:5174

# ========================
# Environment-Specific Settings
# ========================
# For development: use local database and Gemini API
# For production: use production database and ensure XAI_API_KEY is set

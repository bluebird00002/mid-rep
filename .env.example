# ========================================
# MiD Diary - Environment Variables
# ========================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to Git — it contains sensitive credentials
# ========================================

# ========== FRONTEND (Vite) ==========
# API base URL
# For local development: http://localhost:3000/api
# For Render production: https://your-backend-name.onrender.com/api
VITE_API_BASE=http://localhost:3000/api

# ========== BACKEND (Node.js) ==========
# Server port
PORT=3000

# ========== DATABASE (PlanetScale / MySQL) ==========
# Database host (PlanetScale cloud endpoint or local localhost)
DB_HOST=localhost

# Database username
DB_USER=root

# Database password
DB_PASSWORD=

# Database name
DB_NAME=mid_diary

# ========== AUTHENTICATION ==========
# JWT secret for signing tokens (use a strong random string)
# Generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=1d

# Firebase Admin service-account JSON, preferably base64 encoded
FIREBASE_SERVICE_ACCOUNT=

# Cloudinary is required for durable online image storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=mid-uploads
MAX_FILE_SIZE=10485760

# Initial trusted owner account (optional)
MID_BOOTSTRAP_ADMIN_USERNAME=

# ========== MOTHER AI / GROQ ==========
# Server-side gsk_ secret from https://console.groq.com/keys — never put this in CLI config.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ========== CORS & ALLOWED ORIGINS ==========
# Comma-separated list of allowed origins for CORS
# For development: http://localhost:5173,http://localhost:3001
# For Render+Vercel production: https://your-vercel-app.vercel.app
# ========== DEVELOPMENT ==========
# Set to 'development' or 'production'
NODE_ENV=development
